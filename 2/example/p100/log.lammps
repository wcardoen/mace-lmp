fix             2 all npt temp 300 300 0.050000000000000002776                         iso 1.01325 ${Patm} $(1000.0*dt)
fix             2 all npt temp 300 300 0.050000000000000002776                         iso 1.01325 1.01325 $(1000.0*dt)
fix             2 all npt temp 300 300 0.050000000000000002776                         iso 1.01325 1.01325 0.5
run             4000                     # 2 ps
